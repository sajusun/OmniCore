# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME="jamieb84"
APP_ENV=local
APP_KEY=base64:hbDAPhu7ng/2NRt7vyQAocYzUsGWL0XiUos8qEjDv7c=
APP_DEBUG=false
APP_URL=http://master_dashboard.test
APP_TIMEZONE=UTC
SUPPORT_MAIL=support@example.com
FRONTEND_URL=http://jamieb84.test
BACKEND_URL=http://jamieb84.test

# ─── Localization ─────────────────────────────────────────────────────────────
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ─── Maintenance ─────────────────────────────────────────────────────────────
APP_MAINTENANCE_DRIVER=file

# ─── Security ─────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database ─────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=master_dashboard
DB_USERNAME=sakhawat
DB_PASSWORD=

# ─── Session ──────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ─── Queue / Cache / Broadcasting ─────────────────────────────────────────────
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Mail (SMTP Config) ───────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── AWS ──────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── JWT (API Auth) ───────────────────────────────────────────────────────────
JWT_SECRET=lCK4Asjx54l7AYebheXAuJkL0jktNLVtBdWAywtkRNYl8OFRYTQ0Nu9V4TLdltM7
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256
JWT_BLACKLIST_ENABLED=true
JWT_BLACKLIST_GRACE_PERIOD=0
JWT_LEEWAY=0

# ─── Firebase (Push Notifications) ────────────────────────────────────────────
FIREBASE_PROJECT=app
FIREBASE_CREDENTIALS=
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_DEFAULT_BUCKET=
FIREBASE_CREDENTIALS_PATH=

# ─── Reverb (WebSocket / Broadcasting) ────────────────────────────────────────
REVERB_APP_ID=local
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ─── Verification (OTP / Token) ───────────────────────────────────────────────
VERIFICATION_DEFAULT_TYPE=otp
VERIFICATION_OTP_DIGITS=6
VERIFICATION_OTP_EXPIRY_MINUTES=10
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_TOKEN_LENGTH=64
VERIFICATION_TOKEN_EXPIRY_MINUTES=10
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
VERIFICATION_MAX_RESEND_REQUESTS=5
VERIFICATION_BLOCK_HOURS=24
VERIFICATION_SUCCESS_REDIRECT_URL=/verification/success
VERIFICATION_FAILED_REDIRECT_URL=/verification/failed

# ─── Notification Channels ────────────────────────────────────────────────────
NOTIFICATION_DATABASE=true
NOTIFICATION_FIREBASE=true
NOTIFICATION_BROADCAST=true
NOTIFICATION_MAIL=false

# ─── System Feature Toggles ───────────────────────────────────────────────────
ENABLE_ROLE_MANAGEMENT=false
ENABLE_ENV_EDIT=false
IN_APP_NOTIFICATIONS=false
SMS=off
MAIL=on
REVERB=off
RECAPTCHA_ENABLE=no
PAGINATION=12
GOOGLE_MAPS_API_KEY=
APP_LOGO=default/logo.svg



